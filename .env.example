DATABASE_URL=postgres://courier:courier@localhost:15432/courier?sslmode=disable
COURIER_LISTEN=127.0.0.1:18080
COURIER_PUBLIC_URL=http://localhost:18080
COURIER_DEVELOPMENT=true
# Use make dev-env to generate local secrets. Production requires HTTPS.
COURIER_ADMIN_KEY=replace-with-a-random-secret-of-at-least-32-characters
COURIER_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-random-bytes
COURIER_WORKERS=4
COURIER_MAX_ATTEMPTS=12
COURIER_ATTEMPT_TIMEOUT=30s
COURIER_LEASE_DURATION=90s
COURIER_DEDUP_RETENTION=168h
COURIER_DEAD_RETENTION=168h
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
